<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.sunjirapath.bootbomguard</groupId><artifactId>boot-bom-guard-parent</artifactId><version>0.1.0</version></parent>
  <artifactId>boot-bom-guard-maven-plugin</artifactId><packaging>maven-plugin</packaging>
  <name>Boot BOM Guard Maven Plugin</name>
  <url>https://github.com/sunJirapath/boot-bom-guard</url>
  <description>Maven plugin that fails or reports when resolved dependencies drift from a selected Spring Boot BOM</description>
  <prerequisites><maven>3.9.16</maven></prerequisites>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.github.sunjirapath.bootbomguard</groupId><artifactId>boot-bom-guard-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.maven</groupId><artifactId>maven-core</artifactId><version>3.9.16</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven.plugin-tools</groupId><artifactId>maven-plugin-annotations</artifactId><version>3.16.0</version><scope>provided</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-plugin-plugin</artifactId><version>3.16.0</version><configuration><goalPrefix>boot-bom-guard</goalPrefix></configuration></plugin></plugins></build>
</project>
