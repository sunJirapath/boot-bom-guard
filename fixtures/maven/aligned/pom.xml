<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion><groupId>fixture</groupId><artifactId>aligned</artifactId><version>1</version>
  <properties><boot.version>4.0.0</boot.version></properties>
  <dependencyManagement><dependencies><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>${boot.version}</version><type>pom</type><scope>import</scope></dependency></dependencies></dependencyManagement>
  <dependencies><dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency></dependencies>
  <build><plugins><plugin><groupId>io.github.sunjirapath.bootbomguard</groupId><artifactId>boot-bom-guard-maven-plugin</artifactId><version>0.1.0</version></plugin></plugins></build>
  <profiles>
    <profile><id>direct</id><dependencies><dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.18</version></dependency></dependencies></profile>
    <profile><id>managed</id><dependencyManagement><dependencies><dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.18</version></dependency></dependencies></dependencyManagement></profile>
    <profile><id>allowlist</id>
      <dependencies><dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.18</version></dependency></dependencies>
      <build><plugins><plugin><groupId>io.github.sunjirapath.bootbomguard</groupId><artifactId>boot-bom-guard-maven-plugin</artifactId><configuration><exceptions><exception><dependency>org.slf4j:slf4j-api</dependency><reason>Reviewed logging upgrade</reason></exception></exceptions></configuration></plugin></plugins></build>
    </profile>
    <profile><id>invalid-exception</id><build><plugins><plugin><groupId>io.github.sunjirapath.bootbomguard</groupId><artifactId>boot-bom-guard-maven-plugin</artifactId><configuration><exceptions><exception><dependency>org.slf4j:slf4j-api</dependency><reason> </reason></exception></exceptions></configuration></plugin></plugins></build></profile>
    <profile><id>profile-override</id><dependencyManagement><dependencies><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>4.0.1</version><type>pom</type><scope>import</scope></dependency></dependencies></dependencyManagement></profile>
    <profile><id>verbose-conflict</id><dependencies>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.18</version></dependency>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.17</version></dependency>
    </dependencies></profile>
    <profile><id>unresolved</id><dependencies>
      <dependency><groupId>guard.fixture</groupId><artifactId>missing</artifactId><version>1</version></dependency>
    </dependencies></profile>
    <profile><id>duplicate-exception</id><build><plugins><plugin>
      <groupId>io.github.sunjirapath.bootbomguard</groupId><artifactId>boot-bom-guard-maven-plugin</artifactId>
      <configuration><exceptions>
        <exception><dependency>org.slf4j:slf4j-api</dependency><reason>First</reason></exception>
        <exception><dependency>org.slf4j:slf4j-api:jar:</dependency><reason>Alias</reason></exception>
      </exceptions></configuration>
    </plugin></plugins></build></profile>
  </profiles>
</project>
